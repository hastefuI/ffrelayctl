#!/bin/sh

# Docker-based commitlint hook
# Validates commit messages against conventional commit format
# using Docker to avoid adding npm and node as a dependency on the host

set -e

IMAGE=ffrelayctl-commitlint

REPO_ROOT=$(git rev-parse --show-toplevel)
COMMIT_MSG_FILE=$(CDPATH= cd -- "$(dirname -- "$1")" && pwd)/$(basename -- "$1")

docker build -q -t "$IMAGE" "$REPO_ROOT/build/package/commitlint" >/dev/null

exec docker run --rm \
  -v "$REPO_ROOT:/repo:ro" \
  -v "$COMMIT_MSG_FILE:/commit-msg:ro" \
  "$IMAGE" --edit /commit-msg
